# Copy to backend/.env and fill in. Never commit the real .env.

# LLM — any OpenAI-compatible API. Defaults below use Google Gemini.
OPENAI_API_KEY=your-gemini-or-openai-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest

# Web search for fact-grounding
TAVILY_API_KEY=tvly-...

# Voice emotion detection
MODULATE_API_KEY=...

# Telephony (not used yet — reserved for a phone-call version)
PLIVO_AUTH_ID=...
PLIVO_AUTH_TOKEN=...
